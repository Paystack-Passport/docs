{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GlobalStack API",
  "colors": {
    "primary": "#0E141B",
    "light": "#FFFFFF",
    "dark": "#0E141B"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0E0E0D"
    }
  },
  "fonts": {
    "family": "Geist",
    "heading": {
      "family": "Geist",
      "weight": 600
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "🏠 Home",
        "pages": [
          "index"
        ]
      },
      {
        "tab": "🚀 Get Started",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "how-it-works",
              "quickstart"
            ]
          }
        ]
      },
      {
        "tab": "🛠️ Developer Platform",
        "groups": [
          {
            "group": "Guides",
            "pages": [
              "guides/virtual-accounts",
              "guides/collect-and-pay-out",
              "guides/verify-customers",
              "guides/beneficiaries",
              "guides/auto-conversion"
            ]
          },
          {
            "group": "Essentials",
            "pages": [
              "essentials/authentication",
              "essentials/idempotency",
              "essentials/pagination",
              "essentials/rate-limits",
              "essentials/limits",
              "errors",
              "essentials/currency-access"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "webhooks/events",
              "webhooks/verify-signatures"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/failure-reasons",
              "reference/customer-restrictions"
            ]
          }
        ]
      },
      {
        "tab": "📖 API Reference",
        "openapi": "api-reference/openapi.json"
      },
      {
        "tab": "🗒️ Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/api-reference/errors",
      "destination": "/errors"
    },
    {
      "source": "/virtual-accounts",
      "destination": "/guides/virtual-accounts"
    },
    {
      "source": "/guides/fiat-payouts",
      "destination": "/guides/collect-and-pay-out"
    },
    {
      "source": "/api-reference/authentication",
      "destination": "/essentials/authentication"
    },
    {
      "source": "/api-reference/idempotency",
      "destination": "/essentials/idempotency"
    },
    {
      "source": "/api-reference/pagination",
      "destination": "/essentials/pagination"
    },
    {
      "source": "/api-reference/auto-conversion",
      "destination": "/guides/auto-conversion"
    },
    {
      "source": "/api-reference/failure-reasons",
      "destination": "/reference/failure-reasons"
    },
    {
      "source": "/api-reference/customer-restrictions",
      "destination": "/reference/customer-restrictions"
    },
    {
      "source": "/kyc",
      "destination": "/guides/verify-customers"
    }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Home",
        "href": "https://globalstack.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.globalstack.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-spec",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://globalstack.io"
    }
  }
}
